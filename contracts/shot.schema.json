{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/text-to-motion-video/shot-v3.schema.json",
  "type": "object",
  "required": [
    "id",
    "startFrame",
    "endFrame",
    "intent",
    "subject",
    "shotType",
    "characterIds",
    "beforeState",
    "afterState",
    "layers",
    "beats"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "startFrame": {
      "type": "integer",
      "minimum": 0
    },
    "endFrame": {
      "type": "integer",
      "minimum": 1
    },
    "intent": {
      "type": "string",
      "minLength": 4
    },
    "subject": {
      "type": "string",
      "minLength": 4
    },
    "shotType": {
      "enum": [
        "wide",
        "medium",
        "closeup",
        "detail",
        "over-shoulder",
        "insert",
        "aerial"
      ]
    },
    "characterIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      }
    },
    "beforeState": {
      "type": "string",
      "minLength": 4
    },
    "afterState": {
      "type": "string",
      "minLength": 4
    },
    "background": {
      "type": "string"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "assetId",
          "x",
          "y",
          "width",
          "height"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "assetId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "plane": {
            "enum": [
              "back",
              "front"
            ]
          },
          "motion": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "dx": {
                  "type": "number"
                },
                "dy": {
                  "type": "number"
                },
                "scale": {
                  "type": "number"
                },
                "opacity": {
                  "type": "number"
                },
                "rotate": {
                  "type": "number"
                }
              },
              "required": [
                "frame"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "atFrame",
          "action"
        ],
        "properties": {
          "atFrame": {
            "type": "integer",
            "minimum": 0
          },
          "action": {
            "type": "string",
            "minLength": 4
          }
        },
        "additionalProperties": false
      }
    },
    "camera": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "frame"
        ],
        "properties": {
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "zoom": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "sceneOverlay": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
