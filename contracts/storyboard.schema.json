{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "meta",
    "shots"
  ],
  "properties": {
    "version": {
      "const": 3
    },
    "meta": {
      "type": "object",
      "required": [
        "title",
        "width",
        "height",
        "fps"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "integer",
          "minimum": 1
        },
        "background": {
          "type": "string"
        },
        "music": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "shot.schema.json"
      }
    }
  },
  "additionalProperties": false
}
